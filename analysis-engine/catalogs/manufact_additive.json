     "note": "以动态掩模整层投影曝光取代逐点扫描，一次固化整层截面，效率大增。",
     "deps": [
      "stereolithography",
      "ic"
     ]
    },
    {
     "id": "digital_light_processing_am",
     "name": "数字光处理光固化打印",
     "en": "DLP 3D printing",
     "year": 2001,
     "note": "借数字微镜器件逐层投影光固化树脂，精度与速度兼得，成为主流光固化路线。",
     "deps": [
      "projection_stereolithography",
      "ic"
     ]
    },
    {
     "id": "ceramic_stereolithography",
     "name": "陶瓷浆料光固化打印",
     "en": "Ceramic stereolithography",
     "year": 2002,
     "note": "高固含量陶瓷浆料逐层光固化成形生坯，再脱脂烧结得到陶瓷零件。",
     "deps": [
      "stereolithography"
     ]
    },
    {
     "id": "bottom_up_stereolithography",
     "name": "下照式光固化成形",
     "en": "Bottom-up stereolithography",
     "year": 2003,
     "note": "投影自下而上透过窗口固化，逐层抬升成形，树脂用量少且速度快。",
     "deps": [
      "digital_light_processing_am"
     ]
    },
    {
     "id": "ceramic_digital_light_processing",
     "name": "陶瓷数字光固化打印",
     "en": "Lithography-based ceramic manufacturing",
     "year": 2011,
     "note": "以数字投影固化高固含量陶瓷浆料，近净成形氧化锆与羟基磷灰石件。",
     "deps": [
      "digital_light_processing_am"
     ]
    },
    {
     "id": "continuous_liquid_interface_production",
     "name": "连续液面成形",
     "en": "Continuous liquid interface production",
     "year": 2015,
     "note": "以氧气抑制窗口区固化，实现无分层连续光固化，表面光滑且速度快。",
     "deps": [
      "digital_light_processing_am",
      "chemistry"
     ]
    },
    {
     "id": "lcd_masked_stereolithography",
     "name": "LCD掩膜光固化打印",
     "en": "LCD masked stereolithography",
     "year": 2016,
     "note": "以液晶屏作动态掩膜整层曝光，成本低，推动桌面光固化普及。",
     "deps": [
      "digital_light_processing_am"
     ]
    },
    {
     "id": "volumetric_computed_lithography",
     "name": "体积光固化打印",
     "en": "Computed axial lithography",
     "year": 2019,
     "note": "旋转树脂桶并投射多角度光场实现立体一次固化，无需分层支撑，已在研究装置上验证。",
     "deps": [
      "continuous_liquid_interface_production"
     ]
    }
   ]
