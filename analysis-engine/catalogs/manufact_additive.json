 "families": [
  {
   "name": "光聚合（光固化）增材制造技术",
   "items": [
    {
     "id": "photopolymer_layered_prototype",
     "name": "光敏树脂固化快速成形研究装置",
     "en": "Early photopolymer layered prototyping",
     "year": 1981,
     "note": "小玉秀男报道紫外光逐层固化光敏树脂制造立体形状，是最早的光固化打印研究。",
     "deps": [
      "chemistry",
      "computer"
     ]
    },
    {
     "id": "stereolithography",
     "name": "立体光刻成形",
     "en": "Stereolithography",
     "year": 1984,
     "note": "赫尔以紫外激光逐层固化液态光敏树脂并申请专利，奠定光固化3D打印基础。",
     "deps": [
      "photopolymer_layered_prototype",
      "lasers"
     ]
    },
    {
     "id": "solid_ground_curing",
     "name": "实体地面固化",
     "en": "Solid ground curing",
