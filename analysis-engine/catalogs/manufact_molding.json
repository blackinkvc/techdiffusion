 "families": [
  {
   "name": "聚合物注塑成形技术",
   "items": [
    {
     "id": "injection_molding",
     "name": "注塑成型",
     "en": "Injection molding",
     "year": 1872,
     "note": "把熔融塑料高压注入闭合模具冷却成形，是产量最大的塑料制品成形法，始于赛璐珞制品。",
     "deps": [
      "steel",
      "chemistry"
     ]
    },
    {
     "id": "plunger_injection_machine",
     "name": "柱塞式注塑机",
     "en": "Plunger injection molding machine",
     "year": 1872,
     "note": "海厄特以柱塞推动熔料入模并获得专利，是注塑装备的原始形态。",
     "deps": [
      "steel",
      "chemistry"
     ]
    },
    {
     "id": "screw_injection_machine",
     "name": "螺杆式注塑机",
     "en": "Reciprocating screw injection molding machine",
     "year": 1946,
     "note": "亨德里把螺杆塑化与注射合一，塑化均匀稳定，成为现代注塑机主流结构。",
     "deps": [
      "injection_molding",
      "plastics"
     ]
    },
    {
     "id": "insert_injection_molding",
     "name": "嵌件注塑",
     "en": "Insert injection molding",
     "year": 1955,
     "note": "把金属等嵌件预置模内再注塑结合，免去后续装配工序。",
     "deps": [
      "injection_molding"
     ]
    },
    {
     "id": "hot_runner_system",
     "name": "热流道系统",
     "en": "Hot runner system",
     "year": 1960,
     "note": "流道与浇口全程加热保温，注塑免去料柄，省料并缩短成型周期。",
     "deps": [
      "screw_injection_machine"
     ]
    },
    {
     "id": "two_shot_injection_molding",
     "name": "双色注塑",
     "en": "Two-shot injection molding",
     "year": 1961,
     "note": "在同一模内先后注射两种颜色或两种材料，一次获得双色复合制品。",
     "deps": [
      "screw_injection_machine"
     ]
    },
    {
     "id": "structural_foam_injection",
     "name": "结构发泡注塑",
     "en": "Structural foam injection molding",
     "year": 1962,
     "note": "发泡剂使芯层发泡而表层致密，制品刚度高且显著省料。",
     "deps": [
      "injection_molding"
     ]
    },
    {
     "id": "thermoset_injection_molding",
     "name": "热固性注塑",
     "en": "Thermoset injection molding",
     "year": 1965,
     "note": "热固性树脂在螺杆中可控塑化后注入热模固化，用于电器与汽车件。",
     "deps": [
      "screw_injection_machine"
     ]
    },
    {
     "id": "reaction_injection_molding",
     "name": "反应注射成形",
     "en": "Reaction injection molding",
     "year": 1967,
     "note": "双组分聚氨酯等经高压对撞混合后注入模内反应成形，适合大型壳体件。",
     "deps": [
      "plastics",
      "chemistry"
     ]
    },
    {
     "id": "sandwich_injection_molding",
     "name": "夹芯注塑",
     "en": "Sandwich injection molding",
     "year": 1974,
     "note": "先注皮层再注芯层形成包覆结构，可作发泡芯或利用回收料。",
     "deps": [
      "injection_molding"
     ]
    },
    {
     "id": "in_mold_labeling",
     "name": "模内贴标",
     "en": "In-mold labeling",
     "year": 1975,
     "note": "标签预先置入模内与瓶体一体成形，省去后续贴标工序。",
     "deps": [
      "injection_molding"
     ]
    },
    {
     "id": "liquid_silicone_injection",
     "name": "液态硅胶注塑",
     "en": "Liquid silicone rubber injection molding",
     "year": 1980,
     "note": "双组分液态硅胶静态混合后注入热模加硫成形，多用于医用与婴童制品。",
     "deps": [
      "screw_injection_machine"
     ]
    },
    {
     "id": "multi_component_injection",
     "name": "多组分共注塑",
     "en": "Multi-component injection molding",
     "year": 1982,
     "note": "多种热塑性材料在同一模具多次注射，软硬胶一体成形以改善手感与密封。",
     "deps": [
      "two_shot_injection_molding"
     ]
    },
    {
     "id": "all_electric_injection_machine",
     "name": "全电动注塑机",
     "en": "All-electric injection molding machine",
     "year": 1983,
     "note": "以伺服电机直驱各动作机构，节能洁净、重复精度高，用于精密注塑。",
     "deps": [
      "screw_injection_machine"
     ]
    },
    {
     "id": "overmolding",
     "name": "包胶注塑",
     "en": "Overmolding",
     "year": 1985,
     "note": "把基材件放入模内二次注射包覆软胶，常用于手柄与密封件制造。",
     "deps": [
      "insert_injection_molding"
     ]
    },
    {
     "id": "gas_assist_injection",
     "name": "气体辅助注塑",
     "en": "Gas-assisted injection molding",
     "year": 1985,
     "note": "熔料注满后向型腔充入高压氮气，沿壁形成气道以减重防缩。",
     "deps": [
      "injection_molding"
     ]
    },
    {
     "id": "structural_rim",
     "name": "结构反应注射成形",
     "en": "Structural reaction injection molding",
     "year": 1985,
     "note": "模内预置玻纤毡等增强骨架再注射反应料，得到高强度结构泡沫件。",
     "deps": [
      "reaction_injection_molding"
     ]
    },
    {
     "id": "two_platen_injection_machine",
     "name": "二板注塑机",
     "en": "Two-platen injection molding machine",
     "year": 1988,
     "note": "取消肘杆合模机构的两模板结构，锁模力大且占地小，适合大型注塑。",
     "deps": [
      "screw_injection_machine"
     ]
    },
    {
     "id": "injection_compression_molding",
     "name": "注射压缩成形",
     "en": "Injection-compression molding",
     "year": 1990,
     "note": "注射与合模压缩相结合，制品内应力低、缩痕小，用于光学透镜。",
     "deps": [
      "injection_molding"
     ]
    },
    {
     "id": "in_mold_decoration",
     "name": "模内装饰",
     "en": "In-mold decoration",
     "year": 1992,
     "note": "印刷薄膜置入模内与塑件熔合，实现图案与壳体一次成形。",
     "deps": [
      "in_mold_labeling"
     ]
    },
    {
     "id": "micro_injection_molding",
     "name": "微注塑成形",
     "en": "Micro injection molding",
     "year": 1995,
     "note": "以微米级模具与精密螺杆成形微型零件，面向医疗与光通信器件。",
     "deps": [
      "injection_molding"
     ]
    },
    {
     "id": "low_pressure_injection_molding",
     "name": "低压注塑",
     "en": "Low-pressure injection molding",
     "year": 1996,
     "note": "低黏度热熔胶在低压下包封电子元件，防水抗振且损伤元件小。",
     "deps": [
      "screw_injection_machine",
      "semiconductors"
     ]
    },
    {
     "id": "water_assist_injection",
     "name": "水辅助注塑",
     "en": "Water-assisted injection molding",
     "year": 2000,
     "note": "以高压水芯代替气芯成形大直径中空制品，内壁光滑且冷却快。",
     "deps": [
      "gas_assist_injection"
     ]
    },
    {
     "id": "microcellular_foam_molding",
     "name": "超临界微发泡注塑",
     "en": "Microcellular foam injection molding",
     "year": 2000,
     "note": "超临界二氧化碳或氮气形成均匀微孔，制品轻量化且尺寸稳定。",
     "deps": [
      "structural_foam_injection",
      "chemistry"
     ]
    },
    {
     "id": "thin_wall_injection_molding",
     "name": "薄壁注塑",
     "en": "Thin-wall injection molding",
     "year": 2002,
     "note": "高流动树脂高速高压充填薄壁型腔，用于包装与结构轻量化件。",
     "deps": [
      "injection_molding"
     ]
    },
    {
     "id": "rapid_heat_cycle_molding",
     "name": "变模温注塑",
     "en": "Rapid heat cycle molding",
     "year": 2005,
     "note": "模温快速升降消除熔接痕与流痕，获得高光免喷涂表面。",
     "deps": [
      "injection_molding"
     ]
    }
   ]
  },
  {
   "name": "聚合物挤出与压延成形技术",
   "items": [
    {
     "id": "calendering_process",
     "name": "压延成形",
     "en": "Calendering",
     "year": 1880,
     "note": "塑化物料通过多辊辊隙压成厚度均匀的膜片，橡胶与PVC膜片多用此法。",
     "deps": [
      "iron",
      "chemistry"
     ]
    },
    {
     "id": "wire_coating_extrusion",
     "name": "线缆包覆挤出",
     "en": "Wire and cable coating extrusion",
     "year": 1932,
     "note": "熔体连续包覆于牵引线芯上形成绝缘护套，PVC电缆由此大规模生产。",
     "deps": [
      "electricity",
      "plastics"
     ]
    },
    {
     "id": "extrusion_process",
     "name": "挤出成形",
     "en": "Plastics extrusion",
     "year": 1935,
     "note": "熔融塑料在螺杆推动下连续通过口模成形，是管、膜、型材的主要成形方式。",
     "deps": [
      "plastics"
     ]
    },
    {
     "id": "single_screw_extruder",
     "name": "单螺杆挤出机",
     "en": "Single-screw extruder",
     "year": 1935,
     "note": "特罗斯特制造首台热塑性塑料单螺杆挤出机，奠定现代挤出装备基础。",
     "deps": [
      "plastics"
     ]
    },
    {
     "id": "blown_film_extrusion",
     "name": "吹塑薄膜",
     "en": "Blown film extrusion",
     "year": 1938,
     "note": "挤出管坯充气吹胀成膜泡，经冷却压平收卷，是包装薄膜主工艺。",
     "deps": [
      "extrusion_process"
     ]
    },
    {
     "id": "pipe_extrusion",
     "name": "管材挤出",
     "en": "Pipe extrusion",
     "year": 1938,
     "note": "熔体经环形口模连续成形并定径冷却，用于给排水与燃气管道。",
     "deps": [
      "extrusion_process"
     ]
    },
    {
     "id": "twin_screw_extruder",
     "name": "双螺杆挤出机",
     "en": "Twin-screw extruder",
     "year": 1940,
     "note": "科伦坡专利的同向啮合双螺杆，混炼塑化强，广泛用于配混与反应加工。",
     "deps": [
      "extrusion_process"
     ]
    },
    {
     "id": "foam_extrusion",
     "name": "挤出发泡",
     "en": "Foam extrusion",
     "year": 1941,
     "note": "把发泡剂注入熔体，在口模处降压发泡，制得连续泡沫保温板。",
     "deps": [
      "extrusion_process"
     ]
    },
    {
     "id": "monofilament_extrusion",
     "name": "塑料单丝挤出",
     "en": "Monofilament extrusion",
     "year": 1945,
     "note": "熔体经喷丝孔挤出并经拉伸定型成单丝，用于刷丝、渔线与绳索。",
     "deps": [
      "extrusion_process"
     ]
    },
    {
     "id": "cast_film_extrusion",
     "name": "流延膜挤出",
     "en": "Cast film extrusion",
     "year": 1948,
     "note": "熔体经平缝口模流延到冷辊上冷却定型，膜厚均匀、光学性能好。",
     "deps": [
      "extrusion_process"
     ]
    },
    {
     "id": "sheet_extrusion",
     "name": "板材挤出",
     "en": "Sheet extrusion",
     "year": 1948,
     "note": "宽幅平模挤出厚片后经三辊压光冷却，作为吸塑与板材的基材。",
     "deps": [
      "extrusion_process"
     ]
    },
    {
     "id": "extrusion_coating",
     "name": "挤出涂覆",
     "en": "Extrusion coating",
     "year": 1948,
     "note": "把树脂熔体薄层涂覆于纸、铝箔等基材表面，用于复合软包装。",
     "deps": [
      "extrusion_process"
     ]
    },
    {
     "id": "continuous_compounding_mixer",
     "name": "连续混炼机",
     "en": "Continuous compounding mixer",
     "year": 1950,
     "note": "法雷尔连续混炼机把间歇密炼转为连续混炼，与挤出成形相衔接。",
     "deps": [
      "twin_screw_extruder"
     ]
    },
    {
     "id": "meltblown_process",
     "name": "熔喷成形",
     "en": "Melt blowing",
     "year": 1954,
     "note": "熔体细流被高速热气流牵伸成超细纤维并直接成网，用于过滤防护。",
     "deps": [
      "extrusion_process"
     ]
    },
    {
     "id": "extrusion_pelletizing",
     "name": "挤出造粒",
     "en": "Extrusion pelletizing",
     "year": 1955,
     "note": "熔体经口模成条或水下切粒制成规整颗粒，是树脂商品化的形态。",
     "deps": [
      "extrusion_process"
     ]
    },
    {
     "id": "extrusion_lamination",
     "name": "挤出复合",
     "en": "Extrusion lamination",
     "year": 1955,
     "note": "以挤出的树脂膜作粘合层，把纸、铝箔等基材复合成多层材料。",
     "deps": [
      "extrusion_coating"
     ]
    },
    {
     "id": "coextrusion",
     "name": "共挤出",
     "en": "Coextrusion",
     "year": 1958,
     "note": "多台挤出机把不同熔体在口模内复合成多层结构，赋予阻隔等功能。",
     "deps": [
      "twin_screw_extruder"
     ]
    },
    {
     "id": "profile_extrusion",
     "name": "型材挤出",
     "en": "Profile extrusion",
     "year": 1960,
     "note": "异形口模挤出并定型的型材，广泛用于门窗框与密封条。",
     "deps": [
      "extrusion_process"
     ]
    },
    {
     "id": "vented_extruder",
     "name": "排气式挤出机",
     "en": "Vented extruder",
     "year": 1965,
     "note": "机筒中段开设排气口抽走水汽与挥发分，免去原料预干燥。",
     "deps": [
      "twin_screw_extruder"
     ]
    },
    {
     "id": "biaxially_oriented_film",
     "name": "双向拉伸薄膜成形",
     "en": "Biaxially oriented film forming",
     "year": 1974,
     "note": "挤出片材经纵横双向拉伸提高强度与透明性，BOPP膜由此而来。",
     "deps": [
      "cast_film_extrusion"
     ]
    },
    {
     "id": "melt_gear_pump",
     "name": "熔体齿轮泵",
     "en": "Melt gear pump",
     "year": 1975,
     "note": "螺杆出口串接计量齿轮泵，稳定输送并精确控制挤出量。",
     "deps": [
      "extrusion_process"
     ]
    },
    {
     "id": "corrugated_twinwall_pipe",
     "name": "双壁波纹管成形",
     "en": "Corrugated twin-wall pipe forming",
     "year": 1977,
     "note": "挤出熔体在成型模块内连续吹胀出环向波纹，形成高环刚度排水管。",
     "deps": [
      "pipe_extrusion"
     ]
    },
    {
     "id": "planetary_roller_extruder",
     "name": "行星辊筒挤出机",
     "en": "Planetary roller extruder",
     "year": 1985,
     "note": "螺杆外包多根行星辊同时捏合，比表面大、剪切温和，多用于PVC加工。",
     "deps": [
      "twin_screw_extruder"
     ]
    },
    {
     "id": "reactive_extrusion",
     "name": "反应挤出",
     "en": "Reactive extrusion",
     "year": 1985,
     "note": "在挤出机内完成聚合与接枝等反应，流程短且无需溶剂。",
     "deps": [
      "twin_screw_extruder"
     ]
    },
    {
     "id": "micro_tube_extrusion",
     "name": "微细导管挤出",
     "en": "Micro tubing extrusion",
     "year": 1995,
     "note": "精密模具配合在线测径控制，挤出医用级小直径细管。",
     "deps": [
      "extrusion_process"
     ]
    }
   ]
  },
  {
   "name": "中空吹塑、热成形与旋转成形技术",
   "items": [
    {
     "id": "dip_molding",
     "name": "蘸塑成形",
     "en": "Dip molding",
     "year": 1930,
     "note": "把热模浸入糊料或胶乳中蘸取涂层固化，成形手套与防护套。",
     "deps": [
      "chemistry"
     ]
    },
    {
     "id": "extrusion_blow_molding",
     "name": "挤出吹塑成形",
     "en": "Extrusion blow molding",
     "year": 1938,
     "note": "挤出管坯在模具内吹气贴模成形中空件，是塑料瓶桶的主要工艺。",
     "deps": [
      "extrusion_process"
     ]
    },
    {
     "id": "thermoforming_process",
     "name": "热成形",
     "en": "Thermoforming",
     "year": 1940,
     "note": "热塑性片材加热软化后在模具上成形，成本低，用于包装与内饰件。",
     "deps": [
      "plastics"
     ]
    },
    {
