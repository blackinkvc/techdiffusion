     "name": "真空吸塑",
     "en": "Vacuum forming",
     "year": 1942,
     "note": "加热片材在真空吸附下贴模成形，吸塑包装与托盘的主要方法。",
     "deps": [
      "thermoforming_process"
     ]
    },
    {
     "id": "plug_assist_forming",
     "name": "凸模辅助热成形",
     "en": "Plug-assist thermoforming",
     "year": 1945,
     "note": "用预拉伸塞先把热片顶深再吸附成形，改善深拉件的壁厚均匀性。",
     "deps": [
      "thermoforming_process"
     ]
    },
    {
     "id": "rotational_molding",
     "name": "滚塑成形",
     "en": "Rotational molding",
     "year": 1948,
     "note": "粉料在旋转加热模具中熔融附着成形大型中空件，模具成本低。",
     "deps": [
      "plastics"
     ]
    },
    {
     "id": "pressure_thermoforming",
     "name": "压力热成形",
     "en": "Pressure thermoforming",
     "year": 1950,
